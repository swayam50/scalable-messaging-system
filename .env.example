# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=messaging
POSTGRES_USER=messaging
POSTGRES_PASSWORD=change-me

# auth-service JWT signing keys (PEM, PKCS#8 private / X.509 public).
# Leave empty locally: a temporary key is generated (tokens die on restart).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Shared secret chat nodes use to authenticate gRPC calls to each other
CHAT_CLUSTER_SECRET=change-me-cluster-secret

# Object storage (MinIO) root credentials
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-minio-secret

# HMAC secret shared by media-service (signs) and chat-service (verifies); >= 32 chars
MEDIA_SIGNING_SECRET=change-me-to-a-long-random-media-signing-secret
