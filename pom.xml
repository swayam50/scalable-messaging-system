<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Spring Boot parent: manages versions of Spring, Lombok, Flyway, Testcontainers, etc. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>io.wulfcodes.messaging</groupId>
    <artifactId>messaging-system</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>messaging-system</name>
    <description>High-performance messaging system: WebSockets, consistent hashing, gRPC, ScyllaDB</description>

    <modules>
        <module>messaging-common</module>
        <module>auth-service</module>
        <module>chat-service</module>
        <module>media-service</module>
        <module>messaging-ui</module>
        <module>load-test</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <mapstruct.version>1.6.3</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <minio.version>9.0.3</minio.version>
        <okhttp.version>5.3.2</okhttp.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules: children declare them without a version -->
            <dependency>
                <groupId>io.wulfcodes.messaging</groupId>
                <artifactId>messaging-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- MinIO Java SDK (object storage client), not managed by Spring Boot -->
            <dependency>
                <groupId>io.minio</groupId>
                <artifactId>minio</artifactId>
                <version>${minio.version}</version>
            </dependency>
            <!--
              OkHttp 5 is Kotlin Multiplatform: the plain "okhttp" artifact only redirects to
              "okhttp-jvm" via Gradle module metadata, which Maven ignores. Depend on the JVM jar directly.
            -->
            <dependency>
                <groupId>com.squareup.okhttp3</groupId>
                <artifactId>okhttp-jvm</artifactId>
                <version>${okhttp.version}</version>
            </dependency>
            <!-- MapStruct is not managed by Spring Boot -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                  Annotation processors run in this order: Lombok generates getters/builders first,
                  the binding lets MapStruct see them, then MapStruct generates mapper implementations.
                -->
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>-Amapstruct.defaultComponentModel=spring</arg>
                            <arg>-Amapstruct.unmappedTargetPolicy=ERROR</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
